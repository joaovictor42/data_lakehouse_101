# ============================================================
# Credenciais do laboratório. Já vem tudo preenchido — os alunos
# não precisam mexer aqui, só rodar `docker compose up`.
# ============================================================

COMPOSE_PROJECT_NAME=lakehouse

# ---- MinIO (armazenamento S3-compatível) ----
# MinIO exige senha de root com pelo menos 8 caracteres — por isso
# "trilha123" em vez de só "trilha".
MINIO_ROOT_USER=trilha
MINIO_ROOT_PASSWORD=trilha123
MINIO_BUCKET=lakehouse

# ---- Postgres (sistema "fonte" simulado + metastore do Hive/Trino) ----
POSTGRES_USER=trilha
POSTGRES_PASSWORD=trilha123
POSTGRES_DB=database
# Schema onde vivem as 4 tabelas da "lojinha" (customers, products,
# orders, order_items) — em vez do "public" padrão, pra reduzir o que
# o aluno precisa entender ao abrir o dbeaver-web ou o Jupyter.
# Só documentativo aqui: se mudar, teria que atualizar também
# postgres/init/02_dados_fonte.sql e dbeaver/initial-data-sources.conf
# (esses dois não leem o .env).
POSTGRES_SCHEMA=schema

# ---- Jupyter ----
# Sem token/senha, de propósito (ver `command:` do serviço jupyter no
# docker-compose.yml) — abre direto em /lab, sem tela de login. Só é
# seguro porque a porta 8888 não deveria ficar exposta pra fora da
# máquina do aluno; ver README.

# ---- DBeaver-web (CloudBeaver) ----
# Só usadas para o admin (instrutor) acessar http://localhost:8978/#/admin
# se precisar mexer em algo — o aluno nunca faz login, usa acesso anônimo.
DBEAVER_ADMIN_USER=professor
DBEAVER_ADMIN_PASSWORD=Trilha12345
